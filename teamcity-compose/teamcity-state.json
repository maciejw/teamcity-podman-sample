{
  "rootParameters": {
    "teamcity.default.container.engine": "podman"
  },
  "vcsRoots": [
    {
      "id": "CurrentRepository",
      "name": "Current repository",
      "ownerProjectId": "_Root",
      "vcsName": "jetbrains.git",
      "properties": {
        "agentCleanFilesPolicy": "ALL_UNTRACKED",
        "agentCleanPolicy": "ON_BRANCH_CHANGE",
        "authMethod": "ANONYMOUS",
        "branch": "refs/heads/main",
        "ignoreKnownHosts": "true",
        "submoduleCheckout": "CHECKOUT",
        "url": "file:///repo/.git",
        "useAlternates": "AUTO",
        "usernameStyle": "USERID"
      }
    }
  ],
  "projects": [
    {
      "id": "Sample",
      "name": "Sample Testcontainers",
      "parentId": "_Root",
      "vcsRootId": "CurrentRepository",
      "settingsPath": "samples/testcontainers/.teamcity"
    },
    {
      "id": "SampleCompose",
      "name": "Sample Compose",
      "parentId": "_Root",
      "vcsRootId": "CurrentRepository",
      "settingsPath": "samples/compose/.teamcity"
    }
  ]
}
